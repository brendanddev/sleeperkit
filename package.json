{
  "name": "sleeperkit",
  "version": "0.1.0",
  "description": "Typed TypeScript client for the Sleeper fantasy football API, including undocumented endpoints.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "rebuild": "npm run clean && tsc",
    "watch": "tsc --watch --preserveWatchOutput",
    "scratch": "tsx scripts/main.ts",
    "prepublishOnly": "npm run rebuild"
  },
  "keywords": [
    "sleeper",
    "fantasy-football",
    "nfl",
    "api",
    "client",
    "typescript"
  ],
  "author": "Brendan Dileo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brendanddev/sleeperkit.git"
  },
  "bugs": {
    "url": "https://github.com/brendanddev/sleeperkit/issues"
  },
  "homepage": "https://github.com/brendanddev/sleeperkit#readme",
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}